# ---------------------------------------------------------------------------
# AI Determinism Demo - configuration
# Copy this file to ".env" and fill in values. .env is gitignored.
# ---------------------------------------------------------------------------

# Which LLM provider to use for local runs. Options: openai | bedrock | mock
#   openai  -> real OpenAI API (default for local dev)
#   bedrock -> AWS Bedrock (used when deployed to the cloud)
#   mock    -> no API calls; simulates both agents (for offline testing)
LLM_PROVIDER=openai

# Model id for the selected provider.
#   openai example:  gpt-4o-mini
#   bedrock example: anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_MODEL=gpt-4o-mini

# Sampling temperature for Agent A (the non-deterministic agent).
# Must be > 0 to actually demonstrate non-determinism. 0.7 is a good default.
AGENT_A_TEMPERATURE=0.7

# Temperature for Agent B's SQL generation. Determinism comes from the SQL
# engine executing the query, not from this value, but we keep it low.
AGENT_B_TEMPERATURE=0.0

# Default number of runs per question (N).
DEFAULT_RUNS=20

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here

# --- AWS Bedrock (only needed when LLM_PROVIDER=bedrock) ---
# Credentials come from the standard AWS chain (env vars, profile, role).
AWS_REGION=us-east-1
